<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 拨号：本地功能所需（不使用短信，故不申请 SMS 权限）。
         来电播报功能已按隐私要求下架，不再声明/申请 READ_CONTACTS（通讯录）。
         本应用不是默认拨号器，simAccount / TelecomManager.placeCall 那套
         SIM 选卡死代码已删除，随之移除 READ_PHONE_STATE：留着只会让每次拨号
         都写一条「未授予 READ_PHONE_STATE」的误导性轨迹（真机日志实证）。
         CALL_PHONE 仍由点拨号时按需申请；被拒绝时降级 ACTION_DIAL（免权限），
         打开系统拨号盘预填号码，仍能完成呼叫。 -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- 硬件非必需：本应用可跑在没有电话模块 / 摄像头的设备上（如平板） -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- 开机自启：重启后拉起桌面（静态 BOOT_COMPLETED 属隐式广播豁免）。
         应用无常驻前台服务，故不再声明 FOREGROUND_SERVICE / POST_NOTIFICATIONS 等权限。 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 低电量播报系统级定时：息屏也能唤醒提醒，需要唤醒锁与精确闹钟权限
         （API31+ 精确闹钟可能被用户在设置里撤销，届时降级为 inexact 仍可 Doze 唤醒） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 注意：本应用为纯本地应用，不使用 INTERNET 权限 -->

    <!-- Android 11+ 包可见性：不声明的话 queryIntentServices 看不到其他应用的
         TTS 引擎服务，会误判为「系统没有语音引擎」导致播报不可用。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name="com.example.elderlauncher.core.ElderApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ElderLauncher"
        tools:targetApi="34">

        <!-- 桌面主页：HOME 与 LAUNCHER 拆成两个独立 intent-filter。
             合在一个 filter 里时，同一个 Activity 既是「按 Home 键的终点」又是
             「从桌面点图标打开的普通 App」，系统会在两种 task 语义间反复清栈/重建，
             切回系统桌面后表现为动画闪烁、界面闪现（诊断日志实测 20 分钟内 onCreate 4 次）。
             excludeFromRecents：桌面 task 不进最近任务，避免系统额外带前/压后。
             主题用纯色窗口（与桌面背景同色），不再用 Splash 主题，
             这样即使被系统重建也不会重播启动画面。 -->
        <activity
            android:name="com.example.elderlauncher.ui.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.ElderLauncher">
            <!-- 普通 App 入口：从系统桌面点图标进入。
                 保留 DEFAULT：部分 ROM 启动 LAUNCHER 时 intent 会带该 category，
                 少声明会导致隐式解析失败、点图标打不开（拆分前原 filter 是有的）。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- HOME 角色：设为默认桌面后由系统按 Home 键拉起 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 拨号盘 / 来电通话大卡片整套已删除（无入口死代码清理）：
             本应用不申请 ROLE_DIALER，这两套界面常规安装下永远不会被系统拉起。
             tel: 链接一律落到系统拨号器，不再解析回本应用。 -->
        <activity android:name="com.example.elderlauncher.ui.SettingsActivity" android:exported="false" />
        <activity
            android:name="com.example.elderlauncher.ui.ContactEditActivity"
            android:exported="false"
            android:label="@string/edit_contact_title" />

        <!-- 系统广播接收器：只接收系统发出的广播，不对外暴露，
             避免第三方应用伪造「电量不足」触发低电量播报 -->
        <receiver android:name="com.example.elderlauncher.phone.receiver.BatteryReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BATTERY_LOW" />
                <action android:name="android.intent.action.BATTERY_OKAY" />
            </intent-filter>
        </receiver>

        <!-- 低电量播报闹钟：系统级定时哨兵，息屏也能按时提醒（exported=false，仅本应用 AlarmManager 触发） -->
        <receiver
            android:name="com.example.elderlauncher.phone.receiver.LowBatteryAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.elderlauncher.LOW_BATTERY_ALARM" />
            </intent-filter>
        </receiver>

        <!-- 文件提供器：用于拍照时临时保存图片、以及导出诊断日志 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 开机自启：拉起桌面（无常驻服务，低电量播报由静态广播接收器按需触发） -->
        <receiver
            android:name="com.example.elderlauncher.phone.receiver.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

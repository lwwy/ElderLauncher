<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ElderLauncher" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/card_blue</item>
        <item name="colorPrimaryDark">@color/card_blue_dark</item>
        <item name="colorAccent">@color/card_blue</item>
        <item name="android:windowBackground">@color/bg_navy</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/text_on_blue</item>
    </style>

    <!-- 大字号主按钮（其他页面仍用） -->
    <style name="BigButton" parent="Widget.AppCompat.Button">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:backgroundTint">@color/primary</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:padding">20dp</item>
    </style>

    <!-- 首页 2x2 联系人卡片 -->
    <style name="ContactCard">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:background">@drawable/bg_round_contact</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>
</resources>

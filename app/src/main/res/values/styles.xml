<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 全局主题：Material Design 3 深色（蓝色主色）
         说明：本应用刻意固定深色、不启用 Material You 动态取色——
         老人靠颜色认界面，跟随壁纸变色会增加认知负担。这是有意选择，不是遗漏。 -->
    <style name="Theme.ElderLauncher" parent="Theme.Material3.Dark.NoActionBar">
        <!-- M3 颜色角色 -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>
        <item name="colorTertiary">@color/colorTertiary</item>
        <item name="colorOnTertiary">@color/colorOnTertiary</item>
        <item name="colorTertiaryContainer">@color/colorTertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/colorOnTertiaryContainer</item>
        <item name="colorOnBackground">@color/colorOnBackground</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorSurfaceContainer">@color/colorSurfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/colorSurfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/colorSurfaceContainerHighest</item>
        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorOutlineVariant</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <item name="colorErrorContainer">@color/colorErrorContainer</item>
        <item name="colorOnErrorContainer">@color/colorOnErrorContainer</item>

        <item name="android:colorBackground">@color/colorBackground</item>
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:statusBarColor">@color/colorBackground</item>
        <item name="android:navigationBarColor">@color/colorBackground</item>
        <item name="android:editTextColor">@color/colorOnSurface</item>
        <item name="android:textColor">@color/colorOnSurface</item>
    </style>

    <!-- 桌面 Activity 刻意不再使用 SplashScreen 主题：桌面是常驻界面，
         被系统重建时会反复重播启动画面，表现为「闪一下图标再出界面」。
         直接用纯色窗口背景（与桌面内容同色），重建也只是一帧纯色，无可感闪烁。 -->

    <!-- ==================== 文字语义令牌 ==================== -->

    <!-- 设置页分区标题 -->
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/textLabel</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <!-- 设置项下面的说明小字 -->
    <style name="HintText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/textCaption</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- 设置页卡片：统一的表面色 + 大圆角 + 1dp 描边 -->
    <style name="SettingsCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">@dimen/cornerLarge</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- ==================== 按钮 ==================== -->

    <!-- 大字号主按钮（Material 3 填充按钮） -->
    <style name="BigButton" parent="Widget.Material3.Button">
        <item name="android:textSize">@dimen/textHeadline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">20dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="cornerRadius">@dimen/cornerLarge</item>
    </style>

    <!-- 描边按钮：用于“恢复系统桌面”这类次要/逆向操作，视觉上不与主按钮抢焦点 -->
    <style name="BigButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">@dimen/textSection</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">@dimen/cornerLarge</item>
    </style>

    <!-- 设置页联系人行的 ↑ ↓ 排序按钮：无背景、无阴影的纯箭头，48dp 触摸目标（无障碍下限） -->
    <style name="MoveButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:layout_width">@dimen/touchTarget</item>
        <item name="android:layout_height">@dimen/touchTarget</item>
        <item name="android:minWidth">@dimen/touchTarget</item>
        <item name="android:minHeight">@dimen/touchTarget</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textSize">@dimen/textLabel</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- ==================== 卡片 / 头像 ==================== -->

    <!-- 首页 2x2 收藏联系人卡片（MaterialCardView）
         只保留外观属性；尺寸由布局里的 layout_width/height/weight 决定，
         避免 0dp+weight 写在 style 里、GridView 权重不生效时卡片高度塌成 0。 -->
    <style name="ContactCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="cardCornerRadius">@dimen/cornerNone</item>
        <item name="cardElevation">0dp</item>
        <item name="contentPadding">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 直角头像（与首页直角卡片保持一致，避免四角露出卡片底色） -->
    <style name="AvatarRounded">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/cornerNone</item>
    </style>

    <!-- 设置页小头像缩略图 -->
    <style name="AvatarThumb">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/cornerMedium</item>
    </style>
</resources>

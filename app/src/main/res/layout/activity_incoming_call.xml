<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0D0D0D">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/incoming_title"
            android:textColor="#CCCCCC"
            android:textSize="@dimen/textSubtitle" />

        <TextView
            android:id="@+id/tvCaller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/incoming_call"
            android:textColor="@android:color/white"
            android:textSize="@dimen/textHuge"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#CCCCCC"
            android:textSize="@dimen/textSubtitle"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnswer"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:padding="28dp"
                android:text="@string/incoming_answer"
                android:textColor="@android:color/white"
                android:textSize="@dimen/textHeadline"
                android:textStyle="bold"
                app:backgroundTint="@color/answer_green"
                app:cornerRadius="@dimen/cornerLarge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHangup"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:padding="28dp"
                android:text="@string/incoming_hangup"
                android:textColor="@android:color/white"
                android:textSize="@dimen/textHeadline"
                android:textStyle="bold"
                app:backgroundTint="@color/hangup_red"
                app:cornerRadius="@dimen/cornerLarge" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

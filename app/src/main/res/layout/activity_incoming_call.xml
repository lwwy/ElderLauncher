<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC0D0D0D">

    <LinearLayout
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/incoming_title"
            android:textColor="#CCCCCC"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvCaller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/incoming_call"
            android:textColor="@android:color/white"
            android:textSize="48sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#CCCCCC"
            android:textSize="26sp"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp">

            <Button
                android:id="@+id/btnAnswer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:padding="28dp"
                android:text="@string/incoming_answer"
                android:textColor="@android:color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:backgroundTint="@color/answer_green" />

            <Button
                android:id="@+id/btnHangup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="10dp"
                android:padding="28dp"
                android:text="@string/incoming_hangup"
                android:textColor="@android:color/white"
                android:textSize="32sp"
                android:textStyle="bold"
                android:backgroundTint="@color/hangup_red" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页：五个分区（常用联系人 / 来电与通话 / 权限与保活 / 默认应用 / 日志与诊断）。
  分区标题、说明小字、卡片外观都收敛到 styles.xml 的语义样式，
  这里只保留结构和内容，改样式不用逐处改布局。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/settings_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/textTitle"
            android:textStyle="bold" />

        <!-- 零、桌面入口：隐藏/恢复首页右上角齿轮（隐藏后仍可连点时间 5 下进入设置） -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/set_home_title" />

        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/set_hide_settings"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/textSubtitle" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swHideSettings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    style="@style/HintText"
                    android:text="@string/set_hide_settings_tip" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 一、常用联系人 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/set_fav_title" />

        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/HintText"
                    android:text="@string/set_fav_tip" />

                <LinearLayout
                    android:id="@+id/favContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 二、来电与通话 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_call" />

        <com.google.android.material.card.MaterialCardView
            style="@style/SettingsCard"
            app:contentPadding="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/set_incoming"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/textSubtitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestIncoming"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="@string/btn_test" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swIncoming"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/set_lowbattery"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/textSubtitle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTestLow"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="@string/btn_test" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swLow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- 「提示音」是「低电量播报」的二级设置，不是并列的第三项。
                     左侧 2dp 引导竖线 + 整体再缩进 16dp 表达从属关系；
                     标签降为 18sp 灰色并与当前音源合并成一行，不再占用一个大标题。 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/tone_subsection_guide"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="0dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="4dp">

                    <!-- 标签与当前音源同一行；长文件名单行省略，不挤压下方按钮 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SubItemLabel"
                            android:text="@string/set_low_tone" />

                        <TextView
                            android:id="@+id/tvLowToneStatus"
                            style="@style/SubItemStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/low_tone_status_system" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- 主操作：保留描边按钮 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnPickTone"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="@dimen/touchTarget"
                            android:text="@string/btn_pick_tone" />

                        <!-- 次要操作：无边框文字按钮，视觉上不与主按钮抢焦点；
                             禁用态（未选择自定义音频）由颜色状态列表自动淡化 -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnResetTone"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:minHeight="@dimen/touchTarget"
                            android:textColor="@color/tone_secondary_text"
                            android:text="@string/btn_reset_tone" />
                    </LinearLayout>

                    <TextView
                        style="@style/HintText"
                        android:text="@string/low_tone_tip" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 三、权限与保活 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_permission" />

        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAutostart"
                    style="@style/BigButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_autostart" />

                <TextView
                    style="@style/HintText"
                    android:text="@string/autostart_tip" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBattery"
                    style="@style/BigButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/btn_battery" />

                <TextView
                    style="@style/HintText"
                    android:text="@string/battery_tip" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 四、默认应用 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_default" />

        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDefault"
                    style="@style/BigButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/set_default_launcher" />

                <TextView
                    style="@style/HintText"
                    android:text="@string/set_default_tip" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRestoreHome"
                    style="@style/BigButton.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/restore_system_home" />

                <TextView
                    style="@style/HintText"
                    android:text="@string/restore_system_home_tip" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 五、日志与诊断 -->
        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_diagnostic" />

        <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportLog"
                    style="@style/BigButton.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/export_log" />

                <TextView
                    style="@style/HintText"
                    android:text="@string/export_log_tip" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?android:colorBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textSize="30sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="?attr/colorOnSurface"
        android:padding="8dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp"
        app:contentPadding="4dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView android:text="@string/set_incoming" android:textSize="22sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swIncoming"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView android:text="@string/set_lowbattery" android:textSize="22sp"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swLow"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 常用联系人：在设置页管理（桌面只显示头像，点击一键拨号） -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp"
        app:contentPadding="16dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView android:text="@string/set_fav_title" android:textSize="22sp"
                android:textStyle="bold" android:textColor="?attr/colorOnSurface" />
            <TextView android:text="@string/set_fav_tip" android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="4dp" android:layout_marginBottom="8dp" />
            <LinearLayout
                android:id="@+id/favContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 无障碍模式：自动接听 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp"
        app:contentPadding="16dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView android:text="@string/auto_answer" android:textSize="22sp"
                    android:textStyle="bold" android:textColor="?attr/colorOnSurface"
                    android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content" />
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/swAutoAnswer"
                    android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView android:text="@string/auto_answer_tip" android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="4dp" android:layout_marginBottom="8dp" />

            <TextView android:text="@string/auto_answer_delay" android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="4dp" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/delayGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                android:layout_marginTop="8dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelay3"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/delay_sec" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelay5"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/delay_sec" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelay10"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/delay_sec" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 自启动与后台保活 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="16dp"
        app:strokeColor="?attr/colorOutline"
        app:strokeWidth="1dp"
        app:contentPadding="16dp"
        android:layout_marginTop="12dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView android:text="@string/autostart_title" android:textSize="22sp"
                android:textStyle="bold" android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutostart"
                style="@style/BigButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/btn_autostart" />
            <TextView android:text="@string/autostart_tip" android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:padding="8dp" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBattery"
                style="@style/BigButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/btn_battery"
                android:layout_marginTop="4dp" />
            <TextView android:text="@string/battery_tip" android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:padding="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDefault"
        style="@style/BigButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_default_launcher"
        android:layout_marginTop="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_default_tip"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:padding="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDefaultDialer"
        style="@style/BigButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_default_dialer" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/set_default_dialer_tip"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:padding="12dp" />
</LinearLayout>

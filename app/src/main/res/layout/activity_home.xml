<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 顶部：时间卡片（直角，柔和雾蓝） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/colorTimeCard"
            app:cardCornerRadius="@dimen/cornerNone"
            app:cardElevation="0dp"
            app:contentPadding="20dp">

            <LinearLayout
                android:id="@+id/timeBlock"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="0dp"
                android:paddingEnd="64dp">

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/time_placeholder"
                        android:textSize="@dimen/textDisplay"
                        android:textStyle="bold"
                        android:textColor="@android:color/white" />

                    <TextView
                        android:id="@+id/tvAmpm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="@dimen/textSection"
                        android:textColor="@android:color/white"
                        android:layout_marginStart="12dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="@dimen/textLabel"
                    android:textColor="@android:color/white"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvLunar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="@dimen/textTiny"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 设置入口：右上角齿轮图标（看护人使用）。
             用 M3 的 IconButton 形态（自带状态层与 48dp 触摸区）。
             显式关掉 elevation 与 stateListAnimator，避免任何阴影，保持与卡片齐平。
             btnSettings 声明在 cardTime 之后、同处 FrameLayout，绘制层级在上层，
             且不与下方联系人区重叠，所以去掉抬升也不会被压住。 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSettings"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:contentDescription="@string/home_settings"
            app:icon="@drawable/ic_settings"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp"
            app:iconTint="@android:color/white" />
    </FrameLayout>

    <!-- 2x2：三个联系人卡片 + 一个电量卡片。
         每个联系人卡片内部为单层 FrameLayout：照片铺满整卡，姓名叠在照片底部。 -->
    <LinearLayout
        android:id="@+id/gridContacts"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardContact1"
                style="@style/ContactCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp">
                <!-- 照片铺满整张卡片，姓名以图层方式叠在照片底部 -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgAvatar1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person"
                        app:shapeAppearanceOverlay="@style/AvatarRounded" />
                    <!-- 无头像时的占位人像：居中，尺寸略小于卡片 -->
                    <ImageView
                        android:id="@+id/ivPlaceholder1"
                        android:importantForAccessibility="no"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_person"
                        app:tint="@color/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/tvName1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/contact_add"
                        android:textSize="@dimen/textBody"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardContact2"
                style="@style/ContactCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgAvatar2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person"
                        app:shapeAppearanceOverlay="@style/AvatarRounded" />
                    <ImageView
                        android:id="@+id/ivPlaceholder2"
                        android:importantForAccessibility="no"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_person"
                        app:tint="@color/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/tvName2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/contact_add"
                        android:textSize="@dimen/textBody"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="12dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardContact3"
                style="@style/ContactCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="6dp">
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgAvatar3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_person"
                        app:shapeAppearanceOverlay="@style/AvatarRounded" />
                    <ImageView
                        android:id="@+id/ivPlaceholder3"
                        android:importantForAccessibility="no"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_person"
                        app:tint="@color/colorOnSurfaceVariant" />
                    <TextView
                        android:id="@+id/tvName3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/contact_add"
                        android:textSize="@dimen/textBody"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:ellipsize="end"
                        android:maxLines="1" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 电量卡片：去掉电池图标，只留「电量」小字 + 大数字 -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBattery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@color/colorBatteryNormalBg"
                app:cardCornerRadius="@dimen/cornerNone"
                app:cardElevation="0dp"
                app:contentPadding="10dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tvBatteryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_battery"
                        android:textSize="@dimen/textCaption"
                        android:textColor="@color/colorBatteryNormalFg" />

                    <TextView
                        android:id="@+id/tvBattery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/battery_placeholder"
                        android:textSize="@dimen/textMega"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:textColor="@color/colorBatteryNormalFg" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- 底部留白：把卡片区高度收一收（上下变小、左右不变），视觉更透气 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.56" />
</LinearLayout>

# 签名配置模板。
# 用法：复制为同目录下的 keystore.properties 并填入自己的真实值。
# keystore.properties 已被 .gitignore 排除，不会提交到仓库。
#
# 不提供该文件时：debug 使用系统默认 debug 签名，release 产出未签名 APK，
# 构建不会因缺少密钥而失败。
#
# 注意：storeFile 路径相对于仓库根目录。

storeFile=app/your-release.keystore
storePassword=<store password>
keyAlias=<key alias>
keyPassword=<key password>
